      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(request_count_total{status=~\"5..\"}[5m])) / sum(rate(request_count_total[5m]))",
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "stat"
    },
